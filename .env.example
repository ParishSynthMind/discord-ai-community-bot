# Copy to .env (git-ignored) or export these. No values here are real.
# Every secret can instead live in the macOS Keychain (default item names in community_bot/config.py,
# for example discord-bot-token), so nothing secret has to sit in the project folder.
DISCORD_BOT_TOKEN=
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini          # anthropic (default) or gemini
# GEMINI_API_KEY=
STRIPE_WEBHOOK_SECRET=        # whsec_..., comma-separate two while rolling a secret
# LEMONSQUEEZY_SIGNING_SECRET=
# PADDLE_WEBHOOK_SECRET=
# CALENDLY_SIGNING_KEY=
HOOK_URL=                     # your n8n / Make / Zapier webhook
HOOK_SIGNING_SECRET=
ADMIN_TOKEN=                  # a long random string for the dashboard login
# BOT_DB=/path/to/community.db
